# Copy to .env and change every secret.  Generate one with: openssl rand -hex 32
DB_PASSWORD=change-me-db-password
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_TOKEN=change-me-internal-token

S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-password-long
S3_BUCKET=cloud-ai-files
# Address your BROWSER uses to reach MinIO (used for download links)
S3_PUBLIC_ENDPOINT=http://localhost:9000

MAX_UPLOAD_MB=50
MODEL_NAME=all-MiniLM-L6-v2
CORS_ORIGIN=http://localhost:3000
